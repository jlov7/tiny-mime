{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tiny Mime API contracts v1",
  "description": "Named definitions are endpoint contracts. Select the matching $defs entry; semantic/ownership/state rules in api-contracts-v1.md are additionally mandatory. The top-level schema validates PublicRound. Guess Unicode codepoint cap is applied after normalization by semantic validation.",
  "allOf": [
    {
      "$ref": "#/$defs/PublicRound"
    }
  ],
  "$defs": {
    "RoundMutation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "requestId",
        "revision"
      ]
    },
    "CreateRound": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "mode": {
          "enum": [
            "private_play",
            "study"
          ]
        },
        "studySessionId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "executionMode": {
          "enum": [
            "fixture",
            "live"
          ]
        }
      },
      "required": [
        "requestId",
        "mode",
        "studySessionId",
        "executionMode"
      ]
    },
    "GuessInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "attempt": {
          "enum": [
            1,
            2
          ]
        },
        "guess": {
          "type": "string",
          "minLength": 1,
          "maxLength": 480
